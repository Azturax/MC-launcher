# Azure AD public client (no secret) for Microsoft OAuth + PKCE.
# Leave empty to use dry-run auth (profile switcher works, no real tokens).
AUREUM_MS_CLIENT_ID=
AUREUM_MS_TENANT=consumers
AUREUM_OAUTH_REDIRECT_PORT=17890

# Set to 1 to force dry-run even when a client id is present.
AUREUM_AUTH_DRY_RUN=0

# Modrinth OAuth (Author Dashboard). Register an application at
# https://modrinth.com/settings/apps — Modrinth requires a client secret for
# token exchange (kept in Rust / this file only; never sent to the UI).
# Allowlist redirect URI exactly:
#   http://127.0.0.1:17891/modrinth/callback
MODRINTH_CLIENT_ID=
MODRINTH_CLIENT_SECRET=
MODRINTH_OAUTH_REDIRECT_PORT=17891
# Optional override (+ separated). Defaults include USER_READ PROJECT_READ
# PROJECT_WRITE PROJECT_CREATE VERSION_CREATE VERSION_READ VERSION_WRITE.
MODRINTH_OAUTH_SCOPES=
# Set to 1 to simulate connect / list / publish without calling Modrinth.
MODRINTH_AUTH_DRY_RUN=0
